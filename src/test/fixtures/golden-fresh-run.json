{
  "purpose": "Pre-change baseline for a fresh training run, covering the four places golden-weights.json does not reach: buildModel's encoding, the two prep steps' create-versus-update branches, and the CODAP traffic a fresh run generates. Captured from the build at the head of master before the resume work landed, so that sharing the encoding between a fresh run and a resume could be shown to leave a fresh run untouched. A fresh run of this configuration must still produce all of this afterwards.",
  "capturedOn": "2026-08-17",
  "capturedFromCommit": "1c377990b23fce4ce745f8f99c8f886cee846ac5",
  "companionArtifact": "golden-weights.json covers LogisticRegression.fit; this covers everything around it.",
  "howToDriveIt": {
    "summary": "Mock codapInterface.sendRequest, set the target and feature stores up as a chosen document, seed tokenMap the way ngram extraction leaves it, then await modelManager.buildModel().",
    "seedingTrap": "buildModel's oneHot call takes the branch that only adds constructed-feature tokens; the unigrams must already be in tokenMap. Without the seeding step below the run silently fits a one-column model and the baseline guards nothing.",
    "seeding": "oneHot({frequencyThreshold: 3, ignoreStopWords: false, ignorePunctuation: true, includeUnigrams: true, positiveClass: 'pos', negativeClass: 'neg', features: [], newTokenMap: true}, documents)",
    "mockContract": {
      "get *.collectionList": "one collection, so prepResultsCollection takes its create branch",
      "get *.itemSearch[name==*]": "model name empty, so prepWeightsCollection takes its update branch",
      "get *.caseCount": 12,
      "get *.caseByIndex[n]": "case id 700+n named tok<n>",
      "get *.caseFormulaSearch[*]": "ids 101, 102, 103",
      "create": "sequential ids from 5000"
    }
  },
  "dataset": {
    "generator": "MINSTD (Lehmer): s = (s * 48271) % 2147483647, starting from seed; each draw is (s - 1) / 2147483646. Every intermediate stays under 2^53, so the sequence is exact and portable.",
    "seed": 20260817,
    "rows": 40,
    "wordsPerRow": 6,
    "vocabulary": [
      "good",
      "bad",
      "sweet",
      "sour",
      "creamy",
      "icy",
      "rich",
      "bland",
      "fresh",
      "stale"
    ],
    "rowRule": "six draws pick words by index into the vocabulary and are joined with single spaces; one further draw sets sentiment to pos when below 0.5; the column feature 'long' is 1 when the joined text is longer than 28 characters",
    "features": "one ngram feature (unigram, frequency threshold 4, not ignoring stop words) and one column feature named long, both chosen",
    "settings": {
      "iterations": 20,
      "stepMode": false,
      "modelName": "baseline model"
    }
  },
